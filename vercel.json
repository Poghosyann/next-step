{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    { "handle": "filesystem" },
    {
      "src": "/academy-portal/(.*)",
      "dest": "/academy-portal/index.html"
    },
    {
      "src": "/ns-manage-site/(.*)",
      "dest": "/ns-manage-site/index.html"
    }
  ]
}
